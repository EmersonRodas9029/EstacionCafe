{
  "name": "ec_api",
  "version": "1.0.0",
  "main": "dist/api/server.js",
  "scripts": {
    "build": "tsc",
    "start": "nodemon ./dist/api/server.js",
    "start:prod": "node ./dist/api/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d ./api/infrastructure/db/Connection.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d ./api/infrastructure/db/Connection.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d ./api/infrastructure/db/Connection.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d ./api/infrastructure/db/Connection.ts",
    "seed:run": "ts-node api/infrastructure/db/seeders/runSeeder.ts",
    "seed:revert": "ts-node api/infrastructure/db/seeders/runSeeder.ts revert"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisCarcamo1605/EstacionCaf-.git"
  },
  "author": "Christian",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ChrisCarcamo1605/EstacionCaf-/issues"
  },
  "homepage": "https://github.com/ChrisCarcamo1605/EstacionCaf-#readme",
  "description": "",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.27",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/node-cron": "^3.0.11",
    "@types/reflect-metadata": "^0.0.5",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prettier-eslint": "^16.3.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "bcrypt@6.0.0": true,
    "unrs-resolver@1.12.2": true
  }
}
