{
  "name": "estacioncafe-api",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de EstacionCafé (Express + TypeORM + PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "dev": "TS_NODE_TRANSPILE_ONLY=true node --watch -r ts-node/register main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "typeorm": "typeorm-ts-node-commonjs -d ./infrastructure/db/Connection.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "seed:run": "ts-node --transpile-only infrastructure/db/seeders/runSeeder.ts",
    "seed:revert": "ts-node --transpile-only infrastructure/db/seeders/runSeeder.ts revert",
    "test:int": "jest -c jest.integration.config.js",
    "migration:run:prod": "typeorm migration:run -d dist/infrastructure/db/Connection.js",
    "start:prod": "npm run migration:run:prod && node dist/main.js",
    "e2e:db": "ts-node --transpile-only test/e2e/reset-db.ts",
    "start:e2e": "TS_NODE_TRANSPILE_ONLY=true node -r ts-node/register main.ts"
  },
  "author": "EstacionCafé",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  }
}
