NODE_ENV=development
PORT=3484

# Orígenes permitidos (separados por coma). Frontend Vite = 5173
CORS_ORIGIN=http://localhost:5173

# Opción A — Postgres local (docker compose up -d db)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=estacioncafe
DB_PASSWORD=estacioncafe
DB_DATABASE=estacioncafe
DB_SSL=false
DB_LOGGING=false

# Opción B — Supabase / producción (tiene prioridad sobre DB_*)
# DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
# DB_SSL=true

# JWT (obligatorio en producción)
JWT_SECRET=change-me
JWT_EXPIRES_IN_HOURS=12

# Hash de los PIN (obligatorio en producción; cambiarlo invalida todos los PIN)
PIN_PEPPER=change-me-too
PIN_SESSION_MINUTES=30
